# Debian 13 "trixie". Still receiving updates, so apt is pinned to a
# snapshot.debian.org timestamp (see sources.list) to keep the build
# environment fixed.
DIST_OS=Debian
DIST_VERSION=13
DIST_CODENAME=trixie
DIST_SUFFIX=~deb13u1

# debian:13 (13.7, image of 2026-10-27), pinned by digest.
DIST_IMAGE=debian@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1
