# Frozen view of trixie as of 2026-11-04. Bump the timestamp deliberately
# (and rebuild) to pick up newer trixie packages.
deb [signed-by=/usr/share/keyrings/debian-archive-keyring.pgp] http://snapshot.debian.org/archive/debian/20261104T000000Z trixie main
deb [signed-by=/usr/share/keyrings/debian-archive-keyring.pgp] http://snapshot.debian.org/archive/debian/20261104T000000Z trixie-updates main
deb [signed-by=/usr/share/keyrings/debian-archive-keyring.pgp] http://snapshot.debian.org/archive/debian-security/20261104T000000Z trixie-security main
