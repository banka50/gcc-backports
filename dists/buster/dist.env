# Debian 10 "buster". EOL: its final state lives on archive.debian.org and
# no longer changes, so the archive itself is the pin.
DIST_OS=Debian
DIST_VERSION=10
DIST_CODENAME=buster
DIST_SUFFIX=~deb10u1

# debian:10 (10.13), pinned by digest.
DIST_IMAGE=debian@sha256:58ce6f1271ae1c8a2006ff7d3e54e9874d839f573d8009c20154ad0f2fb0a225
