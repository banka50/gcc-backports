# GDB 18, independent of any GCC version: it debugs programs from every
# gcc-N-opt and from the system compiler alike, and auto-loads the libstdc++
# pretty-printers each gcc-N-opt installs under /usr/share/gdb/auto-load.
#
# Plain KEY=value only (sourced by sh and included by make).
KIND=gdb

GDB_VERSION=18.1

UPSTREAM_VERSION=18.1
PKG_NAME=gdb-18-opt
PKG_REVISION=1
PREFIX=/opt/gdb-18

# mtime of every file in the .debs: GDB 18.1 release day, 2026-09-25 UTC.
SOURCE_DATE_EPOCH=1790294400
