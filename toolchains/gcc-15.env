# GCC 15 with its own binutils. Installs into PREFIX; package versions are
# <UPSTREAM_VERSION>-<PKG_REVISION><DIST_SUFFIX>, e.g. 15.3.0-1~deb13u1.
#
# Plain KEY=value only (sourced by sh and included by make).
KIND=gcc

GCC_VERSION=15.3.0
BINUTILS_VERSION=2.47
# From gcc-15.3.0/contrib/download_prerequisites.
GMP_VERSION=6.2.1
MPFR_VERSION=4.1.0
MPC_VERSION=1.2.1
ISL_VERSION=0.24

UPSTREAM_VERSION=15.3.0
PKG_NAME=gcc-15-opt
PKG_REVISION=1
PREFIX=/opt/gcc-15

# mtime of every file in the .debs: GCC 15.3 release day, 2026-06-12 UTC.
SOURCE_DATE_EPOCH=1781222400
