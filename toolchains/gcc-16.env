# GCC 16 with its own binutils. Installs into PREFIX; package versions are
# <UPSTREAM_VERSION>-<PKG_REVISION><DIST_SUFFIX>, e.g. 16.2.0-1~deb13u1.
#
# Plain KEY=value only (sourced by sh and included by make).
KIND=gcc

GCC_VERSION=16.2.0
BINUTILS_VERSION=2.47
# From gcc-16.2.0/contrib/download_prerequisites.
GMP_VERSION=6.3.0
MPFR_VERSION=4.2.2
MPC_VERSION=1.3.1
ISL_VERSION=0.24

UPSTREAM_VERSION=16.2.0
PKG_NAME=gcc-16-opt
PKG_REVISION=1
PREFIX=/opt/gcc-16

# mtime of every file in the .debs: GCC 16.2 release day, 2026-08-07 UTC.
SOURCE_DATE_EPOCH=1786060800
